# Credit-form inquiries. Shaun only — do not add a client lead inbox.
LRL_INQUIRY_EMAIL=shaun.brasher@gmail.com,shaun@lagniapperealmlabs.com
RESEND_API_KEY=
RESEND_FROM=

# Camille chat. OpenAI-compatible chat completions. Leave the key blank to keep the scripted flow.
# If CAMILLE_LLM_API_KEY is unset, /api/chat reports that env var name and does not call a model.
CAMILLE_LLM_API_KEY=
CAMILLE_LLM_BASE_URL=https://api.openai.com/v1
CAMILLE_LLM_MODEL=gpt-4o-mini
# Set to 1 to stop model spend for the day. Chat falls back to the scripted flow.
CAMILLE_LLM_KILL_SWITCH=
